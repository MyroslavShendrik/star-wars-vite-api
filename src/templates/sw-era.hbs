<ul class="sw-era-list">
  {{#each this}}
    <li class="sw-era">
      <img
        src="{{this.erasImage}}"
        alt="{{this.erasImageAlt}}"
      />

      <div class="sw-era__content">
        <h2 class="sw-era__title">
          {{this.erasTitle}}
        </h2>

        <p>{{this.erasDescription}}</p>
      </div>
    </li>
  {{/each}}
</ul>